{
  "name": "pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshot": "node --import tsx core/snapshot.ts",
    "diff": "node --import tsx core/diff.ts",
    "filter": "node --import tsx core/filter.ts",
    "notify": "node --import tsx bot/notify.ts",
    "bot": "node --import tsx bot/server.ts",
    "evals": "node --import tsx evals/run.ts",
    "resolve": "node --import tsx scripts/resolve.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:init": "sqlite3 state/pipeline.sqlite < state/schema.sql"
  },
  "dependencies": {
    "fast-xml-parser": "^5",
    "yaml": "^2",
    "zod": "^4",
    "grammy": "^1",
    "undici": "^6"
  },
  "devDependencies": {
    "tsx": "^4",
    "typescript": "^5",
    "@types/node": "^22"
  }
}
